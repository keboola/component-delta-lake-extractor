{
  "type": "object",
  "title": "Authorization",
  "required": [
    "provider"
  ],
  "properties": {
    "access_method": {
      "enum": [
        "unity_catalog",
        "direct_storage"
      ],
      "type": "string",
      "title": "Data Access Method",
      "default": "direct_storage",
      "options": {
        "enum_titles": [
          "Unity Catalog",
          "Direct Storage Access"
        ]
      },
      "required": true,
      "propertyOrder": 1
    },
    "unity_catalog_url": {
      "type": "string",
      "title": "Unity Catalog URL",
      "propertyOrder": 3,
      "options": {
        "dependencies": {
          "access_method": "unity_catalog"
        }
      }
    },
    "auth_type": {
      "enum": [
        "pat",
        "service_principal"
      ],
      "type": "string",
      "title": "Authentication Type",
      "default": "pat",
      "options": {
        "enum_titles": [
          "Personal Access Token",
          "Service Principal (OAuth M2M)"
        ],
        "dependencies": {
          "access_method": "unity_catalog"
        }
      },
      "description": "Choose how to authenticate to Unity Catalog.",
      "propertyOrder": 4
    },
    "#unity_catalog_token": {
      "type": "string",
      "title": "PAT token",
      "format": "password",
      "propertyOrder": 5,
      "options": {
        "dependencies": {
          "access_method": "unity_catalog",
          "auth_type": "pat"
        }
      }
    },
    "unity_catalog_client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "The service principal's Application (client) ID.",
      "propertyOrder": 6,
      "options": {
        "dependencies": {
          "access_method": "unity_catalog",
          "auth_type": "service_principal"
        }
      }
    },
    "#unity_catalog_client_secret": {
      "type": "string",
      "title": "Client Secret",
      "format": "password",
      "description": "The service principal's OAuth secret.",
      "propertyOrder": 7,
      "options": {
        "dependencies": {
          "access_method": "unity_catalog",
          "auth_type": "service_principal"
        }
      }
    },
    "provider": {
      "enum": [
        "s3",
        "abs",
        "gcs"
      ],
      "type": "string",
      "title": "Cloud Storage",
      "default": "full_sync",
      "options": {
        "dependencies": {
          "access_method": "direct_storage"
        },
        "enum_titles": [
          "AWS S3",
          "Azure Blob Storage",
          "Google Cloud Storage"
        ]
      },
      "required": true,
      "description": "Select the cloud storage provider.",
      "propertyOrder": 2
    },
    "abs_account_name": {
      "type": "string",
      "title": "Storage Account Name",
      "propertyOrder": 3,
      "options": {
        "dependencies": {
          "provider": "abs"
        }
      }
    },
    "#abs_sas_token": {
      "type": "string",
      "title": "SAS token",
      "format": "password",
      "propertyOrder": 4,
      "options": {
        "dependencies": {
          "provider": "abs"
        }
      }
    },
    "abs_port": {
      "type": "integer",
      "title": "Azure Storage Port",
      "description": "(Optional) Non-standard port of the Azure storage endpoint (e.g. a private endpoint, gateway or emulator). Leave empty to use the default HTTPS port. Applies to Azure Blob Storage only, in both Direct Storage and Unity Catalog access.",
      "minimum": 1,
      "maximum": 65535,
      "propertyOrder": 5
    },
    "aws_region": {
      "type": "string",
      "title": "AWS Region",
      "description": "The AWS region where the bucket is located for example 'eu-central-1' or 'us-east-1'.",
      "propertyOrder": 5,
      "options": {
        "dependencies": {
          "provider": "s3"
        }
      }
    },
    "aws_key_id": {
      "type": "string",
      "title": "Access key ID",
      "propertyOrder": 6,
      "options": {
        "dependencies": {
          "provider": "s3"
        }
      }
    },
    "#aws_key_secret": {
      "type": "string",
      "title": "Secret Access Key",
      "format": "password",
      "propertyOrder": 7,
      "options": {
        "dependencies": {
          "provider": "s3"
        }
      }
    },
    "gcp_hmac_id": {
      "type": "string",
      "title": "HMAC Key Access ID",
      "propertyOrder": 6,
      "options": {
        "dependencies": {
          "provider": "gcs"
        }
      }
    },
    "#gcp_hmac_secret": {
      "type": "string",
      "title": "HMAC Key Secret",
      "format": "password",
      "propertyOrder": 9,
      "options": {
        "dependencies": {
          "provider": "gcs"
        }
      }
    }
  }
}